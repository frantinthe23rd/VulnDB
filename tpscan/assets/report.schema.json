{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://vulndb/tpscan/report.schema.json",
 "title": "tpscan third-party exposure report",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "scan",
  "page",
  "summary",
  "consent",
  "vendors",
  "items",
  "cookies",
  "blocked",
  "errors",
  "limitations"
 ],
 "properties": {
  "scan": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "url",
    "finalUrl",
    "scannedAt",
    "toolVersion",
    "consentMode",
    "passes",
    "consentMethod",
    "options"
   ],
   "properties": {
    "url": {
     "type": "string"
    },
    "finalUrl": {
     "type": "string"
    },
    "scannedAt": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "toolVersion": {
     "type": "string"
    },
    "consentMode": {
     "enum": [
      "none",
      "accept",
      "reject",
      "both"
     ]
    },
    "passes": {
     "type": "array",
     "items": {
      "enum": [
       "pre-consent",
       "post-accept",
       "post-reject"
      ]
     }
    },
    "consentMethod": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "options": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "interact",
      "settleMs",
      "dnsCheck",
      "blockPrivate",
      "firstParty"
     ],
     "properties": {
      "interact": {
       "type": "boolean"
      },
      "settleMs": {
       "type": "integer"
      },
      "dnsCheck": {
       "type": "boolean"
      },
      "blockPrivate": {
       "type": "boolean"
      },
      "firstParty": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "page": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "registrableDomain",
    "sensitiveSignals",
    "csp",
    "permissionsPolicy",
    "inlineScripts",
    "rating"
   ],
   "properties": {
    "registrableDomain": {
     "type": "string"
    },
    "sensitiveSignals": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "csp": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "present",
      "reportOnly",
      "policies",
      "scriptSrc",
      "connectSrc",
      "issues"
     ],
     "properties": {
      "present": {
       "type": "boolean"
      },
      "reportOnly": {
       "type": "boolean"
      },
      "policies": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "source",
         "reportOnly",
         "raw",
         "directives"
        ],
        "properties": {
         "source": {
          "enum": [
           "header",
           "meta"
          ]
         },
         "reportOnly": {
          "type": "boolean"
         },
         "raw": {
          "type": "string"
         },
         "directives": {
          "type": "object",
          "additionalProperties": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         }
        }
       }
      },
      "scriptSrc": {
       "type": [
        "array",
        "null"
       ],
       "items": {
        "type": "string"
       }
      },
      "connectSrc": {
       "type": [
        "array",
        "null"
       ],
       "items": {
        "type": "string"
       }
      },
      "issues": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "permissionsPolicy": {
     "type": [
      "string",
      "null"
     ]
    },
    "inlineScripts": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "count",
      "sha256"
     ],
     "properties": {
      "count": {
       "type": "integer"
      },
      "sha256": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "rating": {
     "enum": [
      "critical",
      "high",
      "medium",
      "low",
      "none"
     ]
    }
   }
  },
  "summary": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "items",
    "thirdPartyItems",
    "thirdPartyDomains",
    "vendors",
    "unknownVendors",
    "topFrameThirdPartyScripts",
    "sriCoverage",
    "byRating"
   ],
   "properties": {
    "items": {
     "type": "integer"
    },
    "thirdPartyItems": {
     "type": "integer"
    },
    "thirdPartyDomains": {
     "type": "integer"
    },
    "vendors": {
     "type": "integer"
    },
    "unknownVendors": {
     "type": "integer"
    },
    "topFrameThirdPartyScripts": {
     "type": "integer"
    },
    "sriCoverage": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "with",
      "of"
     ],
     "properties": {
      "with": {
       "type": "integer"
      },
      "of": {
       "type": "integer"
      }
     }
    },
    "byRating": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "critical",
      "high",
      "medium",
      "low",
      "none"
     ],
     "properties": {
      "critical": {
       "type": "integer"
      },
      "high": {
       "type": "integer"
      },
      "medium": {
       "type": "integer"
      },
      "low": {
       "type": "integer"
      },
      "none": {
       "type": "integer"
      }
     }
    }
   }
  },
  "consent": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "mode",
    "passes",
    "diff"
   ],
   "properties": {
    "mode": {
     "enum": [
      "none",
      "accept",
      "reject",
      "both"
     ]
    },
    "passes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "name",
       "method",
       "clicked"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "method": {
        "type": "string"
       },
       "clicked": {
        "type": "boolean"
       }
      }
     }
    },
    "diff": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "onlyAfterAccept",
        "afterReject",
        "preConsent"
       ],
       "properties": {
        "onlyAfterAccept": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "afterReject": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "preConsent": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       }
      }
     ]
    }
   }
  },
  "vendors": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "vendor",
     "category",
     "known",
     "domains",
     "rating",
     "items"
    ],
    "properties": {
     "vendor": {
      "type": "string"
     },
     "category": {
      "enum": [
       "tag-manager",
       "analytics",
       "rum-performance",
       "session-replay",
       "advertising",
       "ab-testing",
       "chat-support",
       "payments",
       "auth-sso",
       "consent",
       "cdn-library",
       "fonts",
       "social",
       "unknown"
      ]
     },
     "known": {
      "type": "boolean"
     },
     "domains": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "rating": {
      "enum": [
       "critical",
       "high",
       "medium",
       "low",
       "none"
      ]
     },
     "items": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^i[0-9]+$"
      }
     }
    }
   }
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "url",
     "host",
     "domain",
     "party",
     "cloaked",
     "cname",
     "vendor",
     "category",
     "frame",
     "frameUrl",
     "loadedBy",
     "chain",
     "initiatorType",
     "method",
     "status",
     "contentType",
     "size",
     "sri",
     "crossorigin",
     "sandbox",
     "allow",
     "evergreen",
     "dynamic",
     "injected",
     "consentGated",
     "passes",
     "rating",
     "reasons",
     "modifiers"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^i[0-9]+$"
     },
     "kind": {
      "enum": [
       "script",
       "iframe",
       "worker",
       "service-worker",
       "websocket",
       "fetch",
       "beacon",
       "image",
       "stylesheet",
       "font",
       "other"
      ]
     },
     "url": {
      "type": "string"
     },
     "host": {
      "type": "string"
     },
     "domain": {
      "type": "string"
     },
     "party": {
      "enum": [
       "first",
       "owned",
       "third"
      ]
     },
     "cloaked": {
      "type": "boolean"
     },
     "cname": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      }
     },
     "vendor": {
      "type": "string"
     },
     "category": {
      "enum": [
       "tag-manager",
       "analytics",
       "rum-performance",
       "session-replay",
       "advertising",
       "ab-testing",
       "chat-support",
       "payments",
       "auth-sso",
       "consent",
       "cdn-library",
       "fonts",
       "social",
       "unknown"
      ]
     },
     "frame": {
      "enum": [
       "top",
       "sub",
       "worker",
       "service-worker"
      ]
     },
     "frameUrl": {
      "type": [
       "string",
       "null"
      ]
     },
     "loadedBy": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^(page|i[0-9]+)$"
     },
     "chain": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "string",
       "pattern": "^(page|unknown|i[0-9]+)$"
      }
     },
     "initiatorType": {
      "type": [
       "string",
       "null"
      ]
     },
     "method": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": [
       "integer",
       "null"
      ]
     },
     "contentType": {
      "type": [
       "string",
       "null"
      ]
     },
     "size": {
      "type": [
       "integer",
       "null"
      ]
     },
     "sri": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "crossorigin": {
      "type": [
       "string",
       "null"
      ]
     },
     "sandbox": {
      "type": [
       "string",
       "null"
      ]
     },
     "allow": {
      "type": [
       "string",
       "null"
      ]
     },
     "evergreen": {
      "type": "boolean"
     },
     "dynamic": {
      "type": "boolean"
     },
     "injected": {
      "type": "boolean"
     },
     "consentGated": {
      "type": "boolean"
     },
     "passes": {
      "type": "array",
      "items": {
       "enum": [
        "pre-consent",
        "post-accept",
        "post-reject"
       ]
      }
     },
     "rating": {
      "enum": [
       "critical",
       "high",
       "medium",
       "low",
       "none"
      ]
     },
     "reasons": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "modifiers": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "cookies": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "thirdParty",
    "firstPartyCount"
   ],
   "properties": {
    "thirdParty": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "name",
       "domain",
       "sameSite",
       "secure",
       "httpOnly"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "domain": {
        "type": "string"
       },
       "sameSite": {
        "type": "string"
       },
       "secure": {
        "type": "boolean"
       },
       "httpOnly": {
        "type": "boolean"
       }
      }
     }
    },
    "firstPartyCount": {
     "type": "integer"
    }
   }
  },
  "blocked": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "url",
     "reason"
    ],
    "properties": {
     "url": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     }
    }
   }
  },
  "errors": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "limitations": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  }
 }
}