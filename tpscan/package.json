{
  "name": "tpscan",
  "version": "0.1.0",
  "description": "Third-party exposure scanner: loads a page in Chromium and rates every third-party service it loads or talks to",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "tpscan": "dist/src/cli.js",
    "tpscan-index": "dist/src/indexer.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:unit": "npm run build && node --test dist/test/unit.test.js",
    "fixture": "npm run build && node dist/test/fixture/serve.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "playwright": "1.63.0",
    "tldts": "7.4.19",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "files": [
    "dist/src",
    "assets"
  ]
}
